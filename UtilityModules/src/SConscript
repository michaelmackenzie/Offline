#!/usr/bin/env python
#
# Script to build the files found in this directory.
#
# Original author Rob Kutschke.
# Adapted by Dave (Lou) Brown

import os as _os, sys as _sys; Import('env'); _sc = File('SConscript').srcnode().abspath; _rt = _sc  # build-component guard: see scripts/build/python/mu2e_components.py
while not _os.path.exists(_rt + '/scripts/build/python/mu2e_components.py'): _rt = _os.path.dirname(_rt)
_sys.path.insert(0, _rt + '/scripts/build/python'); import mu2e_components as _mc
if not _mc.guard(_sc, env['TRIGGER'] == 'on'): Return()

import os
Import('env')
Import('mu2e_helper')

helper=mu2e_helper(env);

# Build RecoNullProducerModule with no MC awareness
helper.make_plugin( 'RecoNullProducer_module.cc',  # This build only applies to one module.
                    [  'art_Framework_Core',
                       'art_Framework_IO_Sources',
                       'art_Framework_Principal',
                       'art_Persistency_Common',
                       'art_Persistency_Provenance',
                       'art_Framework_Services_Registry',
                       'art_root_io_tfile_support',
                       'art_Utilities',
                       'canvas',
                       'fhiclcpp',
                       'fhiclcpp_types',
                       'tbb',
                       'cetlib',
                       'cetlib_except',
                       'CLHEP',
                       'Core',
                       'boost_filesystem',
                    ]
                  )

# Build the remaining plugins with the standard link list
helper.make_plugins( [
                       'MF_MessageLogger',
                       'mu2e_SeedService',
                       'art_Framework_Core',
                       'art_Framework_IO_Sources',
                       'art_Framework_Principal',
                       'art_Persistency_Common',
                       'art_Persistency_Provenance',
                       'art_Framework_Services_Registry',
                       'art_root_io_tfile_support',
                       'art_Utilities',
                       'canvas',
                       'fhiclcpp',
                       'fhiclcpp_types',
                       'tbb',
                       'cetlib',
                       'cetlib_except',
                       'CLHEP',
                       'Core',
                       'boost_filesystem',
                     ],
                     [ 'RecoNullProducer_module.cc' ] # Exclude this from the build
                  )


# This tells emacs to view this file in python mode.
# Local Variables:
# mode:python
# End:
