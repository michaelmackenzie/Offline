# -*- mode: tcl -*-
#------------------------------------------------------------------------------
# RecoMC/fcl/prolog.fcl: sim-side (MC-truth) configuration for the reconstruction packages.
#
# The reconstruction packages (CalPatRec, TrkPatRec, TrkReco, Mu2eKinKal, Lumi, CosmicReco, ...)
# contain no MC configuration.  Everything that needs MC truth lives here, under the single
# top-level table RecoMC:
#
#   RecoMC.DiagPlugins.<Module>   MC diagnostic tool configurations (art tools in RecoMC)
#   RecoMC.producers.*            MC producers  (ComboHitFilter, KLTruthSeed, CHTruthSeed)
#   RecoMC.analyzers.*            MC analyzers  (DeltaFinderAna, NPOTAnalysis, CosmicTrackDiag, CosmicFitDisplay)
#   RecoMC.filters.*              MC filters    (CosmicMuonInfo)
#   RecoMC.Output.*               MC-only output keep-lists (MCTracks, MCDigis, MCHits)
#   RecoMC.McUtils                MC utils tool configuration (see the note there)
#
# Using a diag plugin.  Reco pattern-recognition modules take their diag tool as an OPTIONAL
# delegated parameter, read only when the module's diag level is non-zero.  The reco prologs
# therefore carry diagLevel : 0 and no plugin.  To run a diag job, set both in the job fcl:
#
#   #include "Offline/RecoMC/fcl/prolog.fcl"
#   physics.producers.DeltaFinder.diagLevel  : 1
#   physics.producers.DeltaFinder.diagPlugin : @local::RecoMC.DiagPlugins.DeltaFinder
#
# Some modules spell the parameters with a capital letter: DiagLevel / DiagPlugin
# (CalTimePeakFinder, PhiClusterFinder, TimeAndPhiClusterFinder [Diag/DiagPlugin],
# RobustMultiHelixFinder, RobustHelixFinder).  Check the module's Config.  Example:
#
#   physics.producers.RobustHelixFinder.DiagLevel  : 1
#   physics.producers.RobustHelixFinder.DiagPlugin : @local::RecoMC.DiagPlugins.RobustHelixFinder
#
# Include order: KLTruthSeed/CHTruthSeed use @local::Mu2eKinKal.*, so this file includes the
# Mu2eKinKal prolog itself (before its own BEGIN_PROLOG), like CalPatRec does for TrkCaloDt.fcl.
#------------------------------------------------------------------------------
#include "Offline/Mu2eKinKal/fcl/prolog.fcl"
BEGIN_PROLOG

RecoMC : {
  # NOTE: the tool_types "TrkRecoMcUtils" and "TrkPatRecMcUtils" (used by the DeltaFinder, CalHelixFinder
  # and TZClusterFinder diag plugins below) have NO implementation anywhere in Offline: known upstream
  # issue.  They are kept here verbatim; the tables are only read if the diag tool asks for mcUtils.
  McUtils : { tool_type : "TrkRecoMcUtils"   # does not exist (known upstream issue)
    comboHitCollTag    : "makeSH"
    strawDigiMCCollTag : "compressDigiMCs"
  }
}

RecoMC : { @table::RecoMC
  DiagPlugins : {

    CalTimePeakFinder : { tool_type                    : "CalTimePeakFinderDiag"
        mcTruth   : 0
        diagLevel : 0
    }

    # mcUtils tool_type TrkPatRecMcUtils does not exist (known upstream issue)
    CalHelixFinder : { tool_type                    : "CalHelixFinderDiag"
        mcTruth                                 : 0
        mcUtils                                 : { tool_type : "TrkPatRecMcUtils"
            strawDigiMCCollTag : "compressDigiMCs"
            comboHitCollTag: "makeSH"
        }
    }

    # mcUtils tool_type TrkRecoMcUtils does not exist (known upstream issue)
    DeltaFinder : { tool_type : "DeltaFinderDiag"
        diagLevel               : 0
        mcDiag                  : false
        mcTruth                 : 0
        printComboHits          : 0
        printGoodComboHits      : 0
        printElectrons          : 0
        printElectronsHits      : 0
        printElectronsMinNHits  : 0
        printElectronsMaxFReco  : 1.1                   # if print, then print all
        printElectronsMinMom    : 0                     # by default, print all
        printElectronsMaxMom    : 500.                  # in MeV/c, by default, print all
        printDeltaSeeds         : 0
        printDeltaCandidates    : 0
        printOTracker           : 0                     #
        printShcol              : 0                     #
        printSeedNParents       : -1
        printMcProtons          : 0
        printProtonHits         : 0
        printProtonSeeds        : 0
        printProtonCandidates   : 0
        mcUtils                 : { tool_type : "TrkRecoMcUtils"
            strawDigiMCCollTag : "compressDigiMCs"
            comboHitCollTag    : "makePH"
        }
    }

    # mcUtils (RecoMC.McUtils): tool_type TrkRecoMcUtils does not exist (known upstream issue)
    TZClusterFinder : { tool_type  : "TZClusterFinderDiag"
         mcTruth       : 1
         simIDThresh   : 15
         mcUtils       : { @table::RecoMC.McUtils }
    }

    AgnosticHelixFinder : {
        tool_type : "AgnosticHelixFinderDiag"
        simTag         : ""
        strawDigiMCTag : ""
        display        : true
        showProtons    : false
        debug          : 0
    }

    PhiClusterFinder : {
      diagLevel                    : 0
      tool_type                    : "PhiClusterFinderDiag"
      mcTruth                      : 0
    }

    TimeAndPhiClusterFinder : {
       tool_type             : "TimeAndPhiClusterFinderDiag"
       MCDiag                : true
       StrawDigiMCCollection : "compressDigiMCs"
    }

    RobustMultiHelixFinder : {
       tool_type             : "RobustMultiHelixFinderDiag"
       MCDiag                : true
       StrawDigiMCCollection : "compressDigiMCs"
    }

    RobustHelixFinder : {
       diagLevel                    : 0
       tool_type                    : "RobustHelixFinderDiag"
       mcTruth                      : 0
    }
  }
}

RecoMC : { @table::RecoMC

  # ---- from Mu2eKinKal ----
  # MC-only diagnostic producers: re-seed each reconstructed cosmic fit with the TRUE muon state and
  # re-extrapolate it, isolating the extrapolation (B-field/material) error from the fit error. These
  # consume MC products, so they must NOT be added to any real-data reconstruction path; add them to an
  # MC analysis path after the drift fit and SelectRecoMC. The truth-seeded KalSeed is associated to the
  # same KalSeedMC as its reco parent (see KinematicLineTruthSeed / CentralHelixTruthSeed).
  KLTruthSeed : {
    module_type : KKTruthSeed
    KalSeedCollection : "KKLine"      # reconstructed KKLine KalSeeds to truth-seed
    KalSeedMCAssns : "SelectRecoMC"   # reco KalSeed <-> KalSeedMC; the association propagated to the truth seed
    MCTrajectories : "compressDigiMCs" # true trajectory (set to the sample's MCTrajectory product)
    SeedErrors : [15, 0.05, 10, 0.02, 2.0, 1.0] # d0, phi0, z0, cost, t0, mom (matches KINEMATICLINE)
    KKFitSettings: {
      @table::Mu2eKinKal.KKFIT
      SaveTrajectory: Full
      SaveDomains : false # meaningless for a line fit
      # Sample the truth track at the tracker ends + extracted-CRV sectors so its KalSeed carries the CRV
      # crossings (the truth track has no straw hits, so it relies entirely on this surface sampling).
      SampleSurfaces : ["TT_Front","TT_Back","TT_Outer","CRV_EX","CRV_T1","CRV_T2"]
    }
    FitSettings : @local::Mu2eKinKal.CHSEEDFIT
    ExtensionSettings : @local::Mu2eKinKal.CHDRIFTEXT   # match the reco KKLine ExtensionSettings
    ExtrapolationSettings : @local::Mu2eKinKal.KLXTRAP  # match the reco KKLine ExtrapolationSettings
  }

  CHTruthSeed : {
    module_type : KKTruthSeed
    KalSeedCollection : "KKCHmu"        # reconstructed KKCH KalSeeds to truth-seed
    KalSeedMCAssns : "SelectRecoMC"     # reco KalSeed <-> KalSeedMC; the association propagated to the truth seed
    MCTrajectories : "compressDigiMCs"  # dense true trajectory used to match the piecewise |p| through the tracker
    SeedErrors : [5.0, 0.05, 5.0, 5.0, 0.1, 5.0] # d0, phi0, omega, z0, tandip, t0 (matches CENTRALHELIX)
    KKFitSettings: {
      @table::Mu2eKinKal.KKFIT
      SaveTrajectory : Full
      SaveDomains : false  # the truth track has no BField domains (upstream bfcorr=false), so this
                           # is the honest setting; SaveDomains:true is a no-op here, not a crash
      SampleSurfaces : ["TT_Front","TT_Back","TT_Outer",
        "CRV_T1","CRV_T2","CRV_T3","CRV_T4","CRV_T5",
        "CRV_R1","CRV_R2","CRV_R3","CRV_R4","CRV_R5","CRV_R6",
        "CRV_L1","CRV_L2","CRV_L3","CRV_U","CRV_D1","CRV_D2","CRV_D3","CRV_D4"]
    }
    FitSettings : @local::Mu2eKinKal.CHSEEDFIT
    ExtensionSettings : @local::Mu2eKinKal.CHDRIFTEXT   # match the reco KKCHmu ExtensionSettings
    ExtrapolationSettings : @local::Mu2eKinKal.CHXTRAP  # match the reco KKCHmu ExtrapolationSettings
  }

  # ---- from CalPatRec ----
  ComboHitFilter : { module_type : ComboHitFilter
    chCollTag                                   : "makePH"
    chfCollTag                                  : "DeltaFinder:ComboHits"
    sdmcCollTag                                 : "compressDigiMCs"
    simID                                       : -1                ##
    debugLevel                                  : 0
  }

  DeltaFinderAna : { module_type:DeltaFinderAna
    chCollTag              : "DeltaFinder"           ## "makePH"                # use combo hits
    shCollTag              : "makeSH"                # assume StrawHits have been written out
    sschCollTag            : "DeltaFinder:StrawHits" ## "makeSH"                # 1-straw combohits
    sdmcCollTag            : "compressDigiMCs"
    debugLevel             : 0
    diagLevel              : 0
    printElectrons         : 1
    printElectronsMinNHits : 0
    printElectronsMaxFReco : 1.1                   # if print, then print all
    printElectronHits      : 0
    printComboHits         : 0
    printSingleComboHits   : 0
#     maxElectronHitEnergy          : 0.0035                # for comparisons
  }

  # ---- from Lumi ----
  NPOTAnalysis : {
    module_type: NPOTAnalysis
    caloTag    : "CaloHitMakerFast"
    thCollTag  : "TTmakeSH"
    dfCollTag  : "TTflagPH"
    tcCollTag  : "TrigTZClusterFinder:proton"
    recoPOTTag : "RecoNPOTMaker"
    MCPOTTag   : "PBISim"
    processName: "lumiAna"
    filterName : "lumiStream"
  }

  # ---- from CosmicReco ----
  CosmicFitDisplay : {
     module_type : CosmicFitDisplay
     ComboHitCollection : "makePH"
     TimeClusterCollection : TimeClusterFinderCosmics
     CosmicTrackSeedCollection : CosmicTrackFinder
     doDisplay            : true
     TimeClusterCollection : TimeClusterFinderCosmicsr
     CosmicTrackSeedCollection : CosmicTrackFinder

  }

  CosmicTrackDiag : {
     module_type : CosmicTrackDiag
     StrawHitCollection : "makeSH"
     ComboHitCollection : "makeSH"
     PanelHitCollection : "makeSH"
     TimeClusterCollection : SimpleTimeCluster
     StrawDigiMCCollection : "compressDigiMCs"
     ProtonBunchTimeMC : "EWMProducer"
     CosmicTrackSeedCollection : "CosmicTrackFinderTimeFit"
  }

  CosmicMuonInfo : {
     module_type : CosmicMuonInfo
     strawDigisTag   : "makeSD"
     strawHitsTag    : "makeSH"
     panelHitsTag    : "makePH"
     strawDigiMCsTag : "compressDigiMCs"
     caloDigisTag    : "CaloDigiMaker"
     diagLevel       : 0
     filterCuts      : {
        pmin          : 200. # MeV/c set low
        pmax          : 1000000. # MeV/c currnetly not using
        minStrawDigis :    2  # Minimum number of digis made by the primary muon //10
        minPlanes     :    2  # Minimum number of planes hit by the muon track//3
        minBackground :    0  # Make > 0 to select events with background digis
        maxBackground : 9999  # Make a small number to limit digis not from the muon
     }
  }

  # MC-only output keep-lists (were CosmicReco/fcl/prolog.fcl: Output.MC*)
  Output : {
    MCTracks : ["keep mu2e::GenParticles_*_*_*",
      "keep mu2e::SimParticles_*_*_*" ]
    MCDigis : ["keep mu2e::StrawDigiMCs_*_*_*"]
    MCHits : [ "keep mu2e::StepPointMCs_*_tracker_*",
      "keep mu2e::StepPointMCs_*_virtualdetector_*"]
  }
}

# groupings by art module kind, so job fcls can use @table::RecoMC.analyzers etc.
RecoMC : { @table::RecoMC
  producers : {
    ComboHitFilter : { @table::RecoMC.ComboHitFilter }
    KLTruthSeed    : { @table::RecoMC.KLTruthSeed }
    CHTruthSeed    : { @table::RecoMC.CHTruthSeed }
  }
  analyzers : {
    DeltaFinderAna   : { @table::RecoMC.DeltaFinderAna }
    NPOTAnalysis     : { @table::RecoMC.NPOTAnalysis }
    CosmicFitDisplay : { @table::RecoMC.CosmicFitDisplay }
    CosmicTrackDiag  : { @table::RecoMC.CosmicTrackDiag }
  }
  filters : {
    CosmicMuonInfo   : { @table::RecoMC.CosmicMuonInfo }
  }
}

END_PROLOG
