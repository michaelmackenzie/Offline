# -*- mode: tcl -*-
BEGIN_PROLOG

Lumi : {
    producers : {
        RecoNPOTMaker : {
            module_type      : RecoNPOTMaker
            caloIntInfoTag   : "CaloHitMakerFast"
            trkHitIntInfoTag : "TTmakeSH"
            tcIntInfoTZTag   : "TrigTZClusterFinder:proton"
            tcIntInfoDFTag   : "TTflagPH"
            debugLevel       : 0
        }
    }

    filters : {
        RecoNPOTFilter: {
            module_type         : RecoNPOTFilter
            recoNPOTTag         : "RecoNPOTMaker"
            minWeight           : 0.01
            fileName            : "npot_1b.root"
            debugLevel          : 0
        }
    }
}
END_PROLOG
