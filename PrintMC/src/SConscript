#!/usr/bin/env python
#
# MC (simulation) product printers; the reco/data printers are in Print.
#

import os, re
Import('env')

Import('mu2e_helper')

helper=mu2e_helper(env)

rootlibs  = env['ROOTLIBS']

mainlib = helper.make_mainlib ( [ 'mu2e_Print',
  'mu2e_MCDataProducts',
  'mu2e_GlobalConstantsService',
  'mu2e_DataProducts',
  'art_Framework_Core',
  'art_Framework_Principal',
  'art_Framework_Services_Registry',
  'art_Persistency_Provenance',
  'art_Persistency_Common',
  'art_Utilities',
  'canvas',
  'fhiclcpp',
  'fhiclcpp_types',
  'tbb',
  'cetlib',
  'cetlib_except',
  rootlibs,
  'CLHEP',
  'boost_filesystem',
  ] )

helper.make_plugins( [ mainlib,
  'mu2e_Print',
  'mu2e_MCDataProducts',
  'mu2e_DataProducts',
  'art_Framework_Core',
  'art_Framework_Principal',
  'art_Framework_Services_Registry',
  'art_Persistency_Provenance',
  'art_Persistency_Common',
  'art_Utilities',
  'canvas',
  'MF_MessageLogger',
  'fhiclcpp',
  'fhiclcpp_types',
  'tbb',
  'cetlib',
  'cetlib_except',
  'CLHEP',
  rootlibs,
  'boost_filesystem',
  ] )

# this tells emacs to view this file in python mode.
# Local Variables:
# mode:python
# End:
